// Managed by Ansible — do not edit manually

prometheus.exporter.self "unbork_alloy" {}

prometheus.scrape "unbork_alloy" {
  targets    = prometheus.exporter.self.unbork_alloy.targets
  forward_to = [prometheus.relabel.unbork_alloy.receiver]
}

prometheus.relabel "unbork_alloy" {
  rule {
    target_label = "job"
    replacement  = "alloy"
  }

  rule {
    target_label = "instance"
    replacement  = constants.hostname
  }

  forward_to = [prometheus.remote_write.unbork.receiver]
}
