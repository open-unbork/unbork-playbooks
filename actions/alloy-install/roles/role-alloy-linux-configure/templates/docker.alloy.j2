// Managed by Ansible — do not edit manually

/////////////
// Metrics //
/////////////

prometheus.exporter.cadvisor "unbork_docker" {
  docker_host = "unix:///var/run/docker.sock"
}

prometheus.scrape "unbork_docker" {
  targets    = prometheus.exporter.cadvisor.unbork_docker.targets
  forward_to = [prometheus.relabel.unbork_docker.receiver]
}

prometheus.relabel "unbork_docker" {
  rule {
      target_label = "job"
      replacement = "docker"
  }

  rule {
      target_label = "instance"
      replacement = constants.hostname
  }

  rule {
      source_labels = ["__meta_docker_container_name"]
      regex = "/(.*)"
      target_label = "container"
  }

  rule {
      source_labels = ["__meta_docker_container_log_stream"]
      target_label = "stream"
  }

  forward_to = [
    prometheus.remote_write.unbork.receiver,
  ]
}

////////////
/// Logs ///
////////////

discovery.docker "unbork_docker" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "unbork_docker" {
  targets = discovery.docker.unbork_docker.targets

  rule {
      target_label = "job"
      replacement = "docker"
  }

  rule {
      target_label = "instance"
      replacement = constants.hostname
  }

  rule {
      source_labels = ["__meta_docker_container_name"]
      regex = "/(.*)"
      target_label = "container"
  }

  rule {
      source_labels = ["__meta_docker_container_log_stream"]
      target_label = "stream"
  }
}

loki.source.docker "unbork_docker" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.unbork_docker.targets
  relabel_rules = discovery.relabel.unbork_docker.rules
  // Route through the shared unbork relabel so docker logs also carry the
  // unbork_host_id / unbork_hostname identity labels before hitting
  // loki.write.unbork.
  forward_to    = [loki.relabel.unbork.receiver]
}
